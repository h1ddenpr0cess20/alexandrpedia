{
  "name": "alexandrpedia",
  "version": "0.1.0",
  "description": "A four-sided encyclopedia reading room: AI at the center, surrounded by History, Science, American Popular Culture, and Philosophy & Ideas. Each article is a book from a committed Wikipedia or Grokipedia snapshot.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "snapshot-grokipedia": "node scripts/snapshot-grokipedia.mjs",
    "snapshot-wikipedia": "node scripts/snapshot-wikipedia.mjs",
    "check-titles": "node scripts/check-titles.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "snapshot-all": "npm run snapshot-wikipedia && npm run snapshot-grokipedia",
    "update-articles": "node scripts/update-articles.mjs",
    "build-manifest": "node scripts/build-manifest.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "vite": "^7.3.8"
  },
  "dependencies": {
    "madness-engine": "git+https://github.com/h1ddenpr0cess20/madness-engine.git#5ce6fa2d0a705a4b23f4fdeda54a0c9f4b595ecc"
  }
}
